# Private, single-admin ORION dashboard configuration.
# Create config/dashboard/.env with: npm run dashboard:provision-admin

ORION_DASHBOARD_ADMIN_USERNAME=admin
ORION_DASHBOARD_ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_salt$replace_with_generated_hash
ORION_DASHBOARD_SESSION_SECRET=replace_with_at_least_32_random_bytes

# The first release intentionally binds only to loopback. For remote access,
# keep this binding and place an authenticated HTTPS proxy such as Tailscale
# Serve in front of it.
ORION_DASHBOARD_HOST=127.0.0.1
ORION_DASHBOARD_PORT=4317
ORION_DASHBOARD_PUBLIC_ORIGIN=http://127.0.0.1:4317
ORION_DASHBOARD_SECURE_COOKIE=false

ORION_DASHBOARD_SESSION_TTL_SECONDS=28800
ORION_DASHBOARD_CACHE_TTL_SECONDS=300
ORION_DASHBOARD_LOGIN_WINDOW_SECONDS=900
ORION_DASHBOARD_LOGIN_MAX_ATTEMPTS=5
