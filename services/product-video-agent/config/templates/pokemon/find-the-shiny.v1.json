{
  "template_id": "pokemon.find-the-shiny.v1",
  "template_key": "find-the-shiny",
  "domain": "pokemon",
  "mechanics": [
    "selection",
    "countdown",
    "shiny_reveal"
  ],
  "version": "1.0.0",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_zone": {
      "top": 160,
      "right": 140,
      "bottom": 260,
      "left": 140
    }
  },
  "selection_rules": {
    "subject_table": "pokedex",
    "generation_scope": [],
    "typing_basis": "current_canonical_types_from_all_localized_serebii_generation_pages",
    "require_truth_fields": [
      "national_dex_number",
      "name",
      "types",
      "sprite_path",
      "shiny_sprite_path"
    ],
    "skip_subject_when_missing": [
      "national_dex_number",
      "name",
      "types",
      "sprite_path",
      "shiny_sprite_path"
    ],
    "type_pair_policy": {
      "mode": "random_dual_type_pair",
      "selection_basis": "observed_pairs_in_catalog_only",
      "exclude_zero_match_pairs": true,
      "disallowed_type_pairs": [
        [
          "normal",
          "ice"
        ],
        [
          "normal",
          "bug"
        ],
        [
          "normal",
          "rock"
        ],
        [
          "normal",
          "steel"
        ],
        [
          "fire",
          "fairy"
        ],
        [
          "ice",
          "poison"
        ],
        [
          "ground",
          "fairy"
        ],
        [
          "bug",
          "dragon"
        ],
        [
          "rock",
          "ghost"
        ]
      ],
      "min_catalog_matches": 1,
      "selected_subjects_min": 1,
      "selected_subjects_max": 1
    }
  },
  "question_contract": {
    "hook_text": "Find the Shiny!",
    "hook_text_variants": [
      "Find the Shiny!",
      "Where's the shiny Pokemon?"
    ],
    "hook_voice_required": true,
    "type_prompt_text": "Guess where it's hiding",
    "reveal_text": "Did you find it?"
  },
  "layout": {
    "sprite_grid": {
      "difficulty_weights": {
        "easy": 1,
        "medium": 1,
        "hard": 1
      },
      "difficulty_levels": {
        "easy": {
          "sprite_count": 3,
          "rows": 1,
          "columns": 3
        },
        "medium": {
          "sprite_count": 6,
          "rows": 2,
          "columns": 3
        },
        "hard": {
          "sprite_count": 9,
          "rows": 3,
          "columns": 3
        }
      },
      "available_grids": [
        {
          "rows": 1,
          "columns": 3
        },
        {
          "rows": 2,
          "columns": 3
        },
        {
          "rows": 3,
          "columns": 3
        }
      ],
      "item_size_px": 228,
      "min_item_size_px": 148,
      "column_gap_px": 48,
      "row_gap_px": 62,
      "sprite_scale_multiplier": 1.264,
      "stage_bounds_px": {
        "left": 72,
        "top": 620,
        "width": 936,
        "height": 900
      }
    },
    "pokeball_grid": {
      "overlay_scale_multiplier": 1.404,
      "intro_duration_seconds": 0.72,
      "intro_stagger_seconds": 0.32
    },
    "text": {
      "hook_y": 360,
      "prompt_y": 290,
      "reveal_y": 260,
      "prompt_font_size": 108
    },
    "timer": {
      "countdown_from": 3,
      "countdown_to": 0,
      "position": "upper_middle",
      "display_mode": "numeric_with_small_ring",
      "tick_interval_seconds": 1
    }
  },
  "audio": {
    "voice_peak_db": -3,
    "voice_profile_selection": {
      "mode": "seeded_random",
      "allowed_genders": [
        "female",
        "male"
      ],
      "allow_profile_ids": [
        "us-female-kokoro-heart",
        "us-male-kokoro-deep"
      ]
    },
    "music_enabled": true,
    "music_source_policy": "local_rights_cleared_only",
    "battle_intro_music": {
      "start_seconds": 0,
      "duck_under_voice": true,
      "stop_at_reveal": false
    },
    "sound_effects": {
      "countdown_tick": {
        "enabled": true,
        "trigger": "each_second"
      },
      "timer_end": {
        "enabled": true,
        "trigger": "countdown_complete"
      },
      "shiny": {
        "enabled": true,
        "trigger": "reveal"
      }
    }
  },
  "reveal": {
    "visual_delay_seconds": 0.08,
    "shiny": {
      "enabled": true,
      "max_per_video": 1,
      "sparkle_overlay_role": "shiny_sparkle",
      "sound_effect_role": "shiny",
      "sparkle_duration_seconds": 0.9,
      "sparkle_scale_multiplier": 1.35
    }
  },
  "captions": {
    "max_words_per_line": 4,
    "max_lines": 2,
    "position": "upper_middle",
    "animation": "ass_audio_timed_active_word_highlight",
    "font_family": "Avenir Next",
    "font_size": 74,
    "outline_size": 6
  },
  "renderer": {
    "input_policy": "approved_local_assets_only",
    "video_codec": "libx264",
    "pixel_format": "yuv420p",
    "audio_codec": "aac",
    "audio_bitrate": "192k",
    "crf": 20,
    "faststart": true
  }
}
