{
  "template_id": "pokemon.type-speed-quiz.v1",
  "template_key": "type-speed-quiz",
  "domain": "pokemon",
  "mechanics": [
    "selection",
    "countdown",
    "reveal",
    "transition"
  ],
  "version": "1.0.0",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_zone": {
      "top": 160,
      "right": 100,
      "bottom": 260,
      "left": 100
    }
  },
  "selection_rules": {
    "subject_table": "pokedex",
    "generation_scope": [],
    "require_truth_fields": [
      "national_dex_number",
      "name",
      "types"
    ],
    "preferred_asset_fields": [
      "sprite_path"
    ],
    "skip_subject_when_missing": [
      "national_dex_number",
      "name",
      "types",
      "sprite_path"
    ],
    "round_count": 5,
    "mode": "random",
    "type_cardinality": "any"
  },
  "question_contract": {
    "hook_text": "Can you guess the typing?",
    "hook_text_variants": [
      "Can you guess the typing?"
    ]
  },
  "layout": {
    "background": {
      "source_policy": "local_t7_gif_backgrounds",
      "media_type": "looping_gif_or_video",
      "fit": "cover"
    },
    "text": {
      "hook_y": 320,
      "hook_font_size": 176,
      "prompt_y": 320,
      "prompt_font_size": 176,
      "counter_x": 72,
      "counter_y": 144,
      "counter_font_size": 96,
      "name_y": 1490,
      "name_font_size": 132,
      "type_text_y": 280,
      "type_text_font_size": 78
    },
    "sprite": {
      "center_x": 540,
      "center_y": 990,
      "size_px": 448,
      "scale_multiplier": 2,
      "display_scale_multiplier": 1,
      "auto_display_scale_target_ratio": 0.58,
      "max_auto_display_scale_multiplier": 1.75,
      "intro_duration_seconds": 0.3,
      "intro_lift_px": 44,
      "countdown_float_start_delay_seconds": 0.5,
      "countdown_float_speed_multiplier": 0.75,
      "countdown_float_amplitude_px": 18,
      "countdown_float_frequency_hz": 2.1
    },
    "type_badges": {
      "center_y": 300,
      "icon_size_px": 252,
      "spacing_px": 0,
      "label_anchor_ratio": 0.24,
      "label_gap_px": 80,
      "pop_in_duration_seconds": 0.22
    },
    "timer": {
      "countdown_from": 3,
      "countdown_to": 0,
      "size_px": 268,
      "center_x": 540,
      "center_y": 470
    },
    "rounds": {
      "hook_hold_seconds": 1.1,
      "pre_countdown_hold_seconds": 0.18,
      "reveal_hold_seconds": 0.92,
      "transition_duration_seconds": 0.42,
      "final_hold_seconds": 1.12
    }
  },
  "reveal": {
    "visual_delay_seconds": 0.16,
    "shiny": {
      "enabled": true,
      "sparkle_duration_seconds": 0.9,
      "sparkle_scale_multiplier": 0.5
    }
  },
  "audio": {
    "voice_peak_db": -3,
    "music_enabled": true,
    "music_source_policy": "local_rights_cleared_only",
    "battle_intro_music": {
      "start_seconds": 0,
      "duck_under_voice": true,
      "stop_at_reveal": false
    },
    "voice_profile_selection": {
      "mode": "seeded_random",
      "allowed_genders": [
        "female",
        "male"
      ]
    },
    "sound_effects": {
      "countdown_tick": {
        "enabled": true,
        "trigger": "each_second"
      },
      "timer_end": {
        "enabled": true,
        "trigger": "countdown_complete",
        "preferred_keywords": [
          "ding-sound"
        ]
      }
    }
  },
  "renderer": {
    "input_policy": "approved_local_assets_only",
    "video_codec": "libx264",
    "pixel_format": "yuv420p",
    "audio_codec": "aac",
    "audio_bitrate": "192k",
    "crf": 20,
    "faststart": true
  }
}
