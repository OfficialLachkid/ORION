{
  "template_id": "pokemon.long.bubble-showdown.v1",
  "template_key": "long-bubble-showdown",
  "domain": "pokemon",
  "content_format": "long_form",
  "content_surface": "youtube_watch",
  "version": "1.0.0",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "aspect_ratio": "16:9"
  },
  "episode": {
