    "program_card": {
      "style": "premium_3d",
      "animate_elements": true,
      "card_enter_seconds": 0.55,
      "eyebrow_delay_seconds": 0.18,
      "title_delay_seconds": 0.34,
      "subtitle_delay_seconds": 0.62,
      "element_enter_seconds": 0.42,
      "title_depth_px": 12,
      "title_depth_steps": 6,
      "eyebrow_animation": "slide_fade",
      "title_animation": "letter_wave",
      "subtitle_animation": "rise_fade"
    }
  },
  "layout": {
    "round_transition": {
      "enabled": true,
      "duration_seconds": 1.15,
      "pokeball_size_px": 340,
      "start_scale": 0.08,
      "cover_scale": 7.2,
      "rotation_turns": 1.25
    }
  },
