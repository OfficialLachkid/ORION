    "description_variants": [
      "No stats or type advantage, just physics. Nine Pokemon, three tails each, one survivor per round. How many winners can you predict?",
      "Pick your winner before every Bubble Showdown. No stats, no type advantage - only physics decides who survives."
    ],
    "hashtags": [
      "#pokemon",
      "#pokemonchallenge",
      "#pokemongame",
      "#pokemonquiz"
    ]
  },
  "publication_policy": {
    "manual_review_required": true,
    "night_shift_enabled": false,
    "related_video_enabled": false,
    "auto_comment_enabled": false,
    "custom_thumbnail_required": false,
