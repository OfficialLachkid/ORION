    "outro_duration_seconds": 6,
    "avoid_duplicate_subjects": true
  },
  "round_layout": {
    "frame_width": 960,
    "frame_height": 540,
    "arena_center_x": 480,
    "arena_center_y": 300,
    "arena_radius": 220,
    "arena_shape_pool": [
      "circle",
      "triangle",
      "square",
      "diamond",
      "rectangle",
      "pentagon",
      "hexagon",
      "octagon",
      "trefoil",
      "quatrefoil",
      "pokemon-silhouette"
    ],
    "bubble_radius": 35,
    "title_y": 52,
    "title_font_size": 30,
    "title_side_margin": 60
  },
  "presentation": {
    "accent_color": "0x67DCFF",
