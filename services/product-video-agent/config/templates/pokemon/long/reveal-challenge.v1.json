{
  "template_id": "pokemon.long.reveal-challenge.v1",
  "template_key": "long-reveal-challenge",
  "domain": "pokemon",
  "content_format": "long_form",
  "content_surface": "youtube_watch",
  "version": "1.0.0",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "aspect_ratio": "16:9"
  },
  "episode": {
    "minimum_duration_seconds": 360,
    "target_duration_seconds": 390,
    "maximum_duration_seconds": 600,
    "intro_duration_seconds": 5,
    "outro_duration_seconds": 6,
    "background_switch_interval_sections": 2,
    "avoid_duplicate_subjects": true,
    "repeat_hook_narration": false,
    "reveal_template_keys": [
      "progressive-reveal",
      "pixelated-reveal"
    ],
    "reveal_template_weights": {
      "progressive-reveal": 2,
      "pixelated-reveal": 1
    }
  },
  "assets": {
    "minimum_background_width": 1280,
    "minimum_background_height": 720,
    "minimum_background_aspect_ratio": 1.4
  },
  "presentation": {
    "accent_color": "0xFFD60A",
    "intro_eyebrow": "GET READY TO GUESS",
    "intro_title": "GUESS THE POKEMON",
    "intro_subtitle": "PROGRESSIVE + PIXELATED REVEALS",
    "outro_eyebrow": "REVEAL CHALLENGE COMPLETE",
    "outro_title": "HOW MANY DID YOU GET?",
    "outro_subtitle": "SHARE YOUR SCORE IN THE COMMENTS",
    "outro_accent_color": "0x56C7FF"
  },
  "layout": {
    "background": {
      "blur_sigma": 8,
      "motion": {
        "enabled": true,
        "zoom_scale": 1.3,
        "subpixel_scale": 1.5
      }
    },
    "round_transition": {
      "enabled": true,
      "duration_seconds": 1.15,
      "pokeball_size_px": 340,
      "start_scale": 0.08,
      "cover_scale": 7.2,
      "rotation_turns": 1.25
    }
  },
  "audio": {
    "music_volume": 0.16,
    "music_crossfade_seconds": 2,
    "music_ending_fade_seconds": 2.5
  },
  "renderer": {
    "video_codec": "libx264",
    "preset": "fast",
    "crf": 21,
    "pixel_format": "yuv420p",
    "audio_codec": "aac",
    "audio_bitrate": "192k",
    "faststart": true
  },
  "publication": {
    "title": "Guess the Pokemon - Ultimate Reveal Challenge",
    "description": "Guess each Pokemon before the progressive or pixelated reveal completes. Keep score through every round and share your result in the comments.",
    "hashtags": [
      "#pokemon",
      "#pokemonquiz",
      "#guessthepokemon",
      "#pokemonchallenge"
    ]
  },
  "publication_policy": {
    "manual_review_required": true,
    "night_shift_enabled": false,
    "related_video_enabled": false,
    "auto_comment_enabled": false,
    "custom_thumbnail_required": false,
    "playlist_enabled": false,
    "watermark_enabled": false
  }
}
